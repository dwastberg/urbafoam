// Building models generated by urbafoam, included by system/snappyHexMeshDict.

buildingGeometry
{
{{#buildingModels}}
    {{name}}
    {
        type    triSurfaceMesh;
        file    "{{filename}}";
    }
{{/buildingModels}}
}

buildingFeatures
(
{{#buildingModels}}
    {
        file    "{{file_basename}}.eMesh";
        level   {{featureLevel}};
    }
{{/buildingModels}}
);

buildingSurfaces
{
{{#buildingModels}}
    {{name}}
    {
        level       {{refinementLevel}};
        patchInfo   { type wall; }
    }
{{/buildingModels}}
}

buildingLayers
{
{{#buildingModels}}
    {{name}}
    {
        nSurfaceLayers $nSurfaceLayers;
    }
{{/buildingModels}}
}

