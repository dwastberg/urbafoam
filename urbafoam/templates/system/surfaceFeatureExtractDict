FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

{{#buildingModels}}
{{filename}}
{
    extractionMethod    extractFromSurface;

    // Mark edges where adjacent surface normals differ by more than (180 - includedAngle) degrees.
    includedAngle       {{includedAngle}};

    subsetFeatures
    {
        nonManifoldEdges    yes;
        openEdges           yes;
    }

    trimFeatures
    {
        minElem         0;
        minLen          0;
    }

    writeObj            yes;
}

{{/buildingModels}}
