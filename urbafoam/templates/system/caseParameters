centralRefinementLevel     {{insideRefinementLevel}};
centralGroundRefinement    {{verticalCentralRefinement}};
nCellsBetweenLevels        {{nCellsBetweenLevels}};
nSurfaceLayers             {{nSurfaceLayers}};

// * * * * * * * * * * * * * * * * Solver  * * * * * * * * * * * * * * * * * //

