writeInterval   {{writeInterval}};
purgeWrite      {{purgeWrite}};

gradLimitU      {{gradLimit_U}};
gradLimitP      {{gradLimit_p}};
gradLimitK      {{gradLimit_k}};
gradLimitEpsilon {{gradLimit_epsilon}};

// * * * * * * * * * * * * * * * * Parallel  * * * * * * * * * * * * * * * * //

nProcs          {{procCount}};   // > 1 runs the case in parallel (read by Allrun)

