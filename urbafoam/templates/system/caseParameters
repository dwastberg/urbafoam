xCells          {{x_cells}};
yCells          {{y_cells}};
zCells          {{z_cells}};
zGrading        {{z_grading}};

// * * * * * * * * * * * * * * * * Meshing * * * * * * * * * * * * * * * * * //

// central analysis area around the primary buildings (system/snappyHexMeshDict)
analysisMin     ({{analysis_minx}} {{analysis_miny}} {{analysis_minz}});
analysisMax     ({{analysis_maxx}} {{analysis_maxy}} {{analysis_maxz}});
analysisGround  ({{analysis_maxx}} {{analysis_maxy}} {{analysis_minz}});
domainGroundMin ({{background_minx}} {{background_miny}} {{analysis_minz}});
domainGroundMax ({{background_maxx}} {{background_maxy}} {{analysis_minz}});
