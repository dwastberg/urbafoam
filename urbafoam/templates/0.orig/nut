FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #include "include/ABLConditions"
    inlet
    {
        type            calculated;
        value           uniform 0;
    }

    outlet
    {
        type            calculated;
        value           uniform 0;
    }

    wall
    {
        type            atmNutkWallFunction;
        z0              $z0Walls;
        value           uniform 0.0;
    }

    ground 
    {
        type            atmNutkWallFunction;
        z0              $z0;
        value           uniform 0.0;
    }

    ".*"
    {
        type            atmNutkWallFunction;
        z0              $z0Other;
        value           uniform 0.0;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}
// ************************************************************************* //
