#!/bin/sh
cd "${0%/*}" || exit 1                              # Run from this directory
. "${WM_PROJECT_DIR:?}"/bin/tools/RunFunctions      # OpenFOAM run functions
#------------------------------------------------------------------------------
# Usage: ./Allrun [-v|--verbose] [mesh] [solve] [sample]   (no stages runs all three)
#
# Runs in parallel when numberOfSubdomains in system/decomposeParDict is above 1
# (nProcs in system/caseParameters). Stops at the first application that fails;
# see its log.* file. With -v/--verbose, each application's log is also printed
# to stdout while it runs.
#------------------------------------------------------------------------------

verbose=false
stages=
for arg
do
    case "$arg" in
    -v | --verbose) verbose=true ;;
    *) stages="$stages $arg" ;;
    esac
done
stages="${stages:-mesh solve sample}"
nProcs=$(getNumberOfProcessors)
usePotentialFoam=$(foamDictionary -entry usePotentialFoam -value system/caseParameters)

fail()
{
    echo "$1 failed, see $PWD/log.$1" 1>&2
    exit 1
}

# Stop printing the log started by launch, once tail has had time to print its last lines
tailPid=
stop_tail()
{
    [ -n "$tailPid" ] || return 0
    sleep 1
    kill "$tailPid" 2>/dev/null
    wait "$tailPid" 2>/dev/null
    tailPid=
}
trap stop_tail EXIT
trap 'exit 130' INT TERM

# launch runApplication|runParallel <application> [args]: run it, overwriting its log.
# With --verbose, also print the log to stdout while the application runs.
launch()
{
    runner="$1"
    shift
    if [ "$verbose" = true ]
    then
        : > "log.$1"
        tail -n +1 -f "log.$1" &
        tailPid=$!
    fi
    "$runner" -o "$@"
    status=$?
    stop_tail
    return $status
}

# Run an application, in parallel if the case is decomposed
run()
{
    if [ "$nProcs" -gt 1 ]
    then
        launch runParallel "$@" || fail "$1"
    else
        launch runApplication "$@" || fail "$1"
    fi
}

# Report the mesh quality. Failed checks are a warning: the solver often copes with a few poor cells.
check_mesh()
{
    if [ "$nProcs" -gt 1 ]
    then
        launch runParallel checkMesh
    else
        launch runApplication checkMesh
    fi
    if grep -q "Failed [0-9]* mesh checks" log.checkMesh
    then
        echo "Warning: checkMesh: $(grep -o 'Failed [0-9]* mesh checks' log.checkMesh | tail -1)," \
             "see $PWD/log.checkMesh" 1>&2
    elif ! grep -q "Mesh OK" log.checkMesh
    then
        fail checkMesh
    fi
    if grep -q "cell limit" log.snappyHexMesh 2>/dev/null  # "... since reaching my cell limit of"
    then
        echo "Warning: snappyHexMesh reached maxGlobalCells and stopped refining," \
             "see $PWD/log.snappyHexMesh" 1>&2
    fi
}

for stage in $stages
do
    case "$stage" in
    mesh)
        [ -d 0 ] || cp -r 0.orig 0
        launch runApplication surfaceFeatureExtract || fail surfaceFeatureExtract
        launch runApplication blockMesh || fail blockMesh
        if [ "$nProcs" -gt 1 ]
        then
            launch runApplication decomposePar -force -copyZero || fail decomposePar
        fi
        run snappyHexMesh -overwrite
        check_mesh
        ;;
    solve)
        if [ "$usePotentialFoam" = true ]
        then
            run potentialFoam
        fi
        run simpleFoam
        ;;
    sample)
        run postProcess -latestTime -func sampleDict
        ;;
    *)
        echo "Unknown stage '$stage': use mesh, solve or sample" 1>&2
        exit 1
        ;;
    esac
done

touch "${PWD##*/}.foam"

#------------------------------------------------------------------------------
