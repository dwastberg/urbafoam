// Parameters of the atmBoundaryLayerInlet* conditions (libatmosphericModels).
// With the default C1 = 0, C2 = 1 they give the Richards & Hoxey (1993) profiles
//
//     U = (Ustar/kappa) ln((z - d + z0)/z0),  Ustar = kappa Uref/ln((Zref + z0)/z0)
//
// with z measured from the lowest point of the inlet patch, z0 the aerodynamic roughness
// length and d the displacement height. See src/atmosphericModels/derivedFvPatchFields/atmBoundaryLayer.


Uref                 10;
Href                 30;
z0                   uniform 1.0;
windDirection        (1 0 0);
zDirection           (0 0 1);
d                    uniform 0;   // displacement height

// z0 is also the roughness of the ground patch. Roughness length of the buildings and of other
// wall patches, for the wall functions of nut, epsilon and omega
z0Walls              uniform 0.001;
z0Other              uniform 0.001;

