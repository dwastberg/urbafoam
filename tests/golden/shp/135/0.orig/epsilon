FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// epsilonInlet  0.03; // Cmu^0.75 * k^1.5 / L ; L =10
#include        "include/initialConditions"

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform $turbulentEpsilon;


boundaryField
{
    #include "include/ABLConditions"

    inlet
    {
        type            atmBoundaryLayerInletEpsilon;
        flowDir         $windDirection;
        Uref            $Uref;
        Zref            $Href;
        zDir            $zDirection;
        z0              $z0;
        d               $d;
    }

    outlet
    {
          type            zeroGradient;        
    }

    // rough wall functions with the same z0 as nut (see include/ABLConditions)
    ground
    {
        type            atmEpsilonWallFunction;
        z0              $z0;
        value           $internalField;
    }

    wall
    {
        type            atmEpsilonWallFunction;
        z0              $z0Walls;
        value           $internalField;
    }

    ".*"
    {
        type            atmEpsilonWallFunction;
        z0              $z0Other;
        value           $internalField;
    }
    #includeEtc "caseDicts/setConstraintTypes"

}

