FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// https://www.openfoam.com/documentation/cpp-guide/html/guide-meshing-snappyhexmesh-castellation.html

#include "etc/snappyHexMeshDict.cfg"

castellatedMesh on;
snap            on;
addLayers       off;

geometry
{

    buildings
    {
        type triSurfaceMesh;
        file "buildings.stl";
    }



    BoxZ  // refinement based on z level over whole domain
    {
     type searchableBox;
     min  (1394565.280977278 4989603.606933245 0.0);
     max  (1394913.905129311 4989889.206775254 0.0);
    }


    Box1 // central area
    {
        type searchableBox;
        min  (1394614.280977278 4989668.606933245 0.0);
        max  (1394800.905129311 4989824.206775254 16.0);
    }

    Plane1 // central area
    {
        type searchableBox;
        min  (1394614.280977278 4989668.606933245 0.0);
        max  (1394800.905129311 4989824.206775254 0.0);
    }


};

castellatedMeshControls
{


    features
    (
      {
        file  "buildings.eMesh";
        level 4;
      }
    );

    refinementSurfaces
    {

        buildings
        {
            level (2 4);
            patchInfo  { type wall; }
        }

    }

    refinementRegions
    {

     BoxZ  // Vertical throughout domain
     {
         mode distance;
         levels ((5.333333333333333 2));
     }

     Box1
     {
         mode inside;
         levels ((1e15 2));
     }

     Plane1
     {
         mode distance;
         levels ((3 4) (12 2));
     }

    }

    locationInMesh (1394566.280977278 4989604.606933245 47.0);
}

snapControls
{



    explicitFeatureSnap    true;
    implicitFeatureSnap    false;
}

addLayersControls
{
    layers
    {
        ".*"
        {
            nSurfaceLayers 2;
        }
    }

    relativeSizes       true;
    expansionRatio      1.3;
    finalLayerThickness 0.5;
    minThickness        1e-3;


}

writeFlags
(
    scalarLevels
    layerSets
    layerFields
);


