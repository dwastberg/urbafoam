FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

buildings.stl
{
    extractionMethod    extractFromSurface;

    // Mark edges whose adjacent surface normals are at an angle less than includedAngle as features
    includedAngle       150;

    subsetFeatures
    {
        nonManifoldEdges    yes;
        openEdges           yes;
    }

    trimFeatures
    {
        minElem         0;
        minLen          0;
    }

    writeObj            yes;
}

