FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// https://www.openfoam.com/documentation/guides/latest/doc/guide-meshing-snappyhexmesh.html

#include "caseParameters"
#include "buildingModels"
#include "etc/snappyHexMeshDict.cfg"

castellatedMesh on;
snap            on;
addLayers       $addSurfaceLayers;

geometry
{
    $buildingGeometry;

    BoxZ    // ground plane over the whole domain, for refinement by height
    {
        type    searchableBox;
        min     $domainGroundMin;
        max     $domainGroundMax;
    }

    Box1    // central analysis area
    {
        type    searchableBox;
        min     $analysisMin;
        max     $analysisMax;
    }

    Plane1  // ground plane of the central analysis area
    {
        type    searchableBox;
        min     $analysisMin;
        max     $analysisGround;
    }
}

castellatedMeshControls
{
    features $buildingFeatures;

    refinementSurfaces
    {
        $buildingSurfaces;
    }

    refinementRegions
    {
        BoxZ    // vertical refinement throughout the domain
        {
            mode    distance;
            levels  (($verticalRefinementDistance $verticalRefinementLevel));
        }

        Box1
        {
            mode    inside;
            levels  ((1e15 $centralRefinementLevel));
        }

        Plane1
        {
            mode    distance;
            levels  $centralGroundRefinement;
        }
    }

    locationInMesh $insidePoint;
}

snapControls
{
    explicitFeatureSnap    true;
    implicitFeatureSnap    false;
}

addLayersControls
{
    layers
    {
        ground
        {
            nSurfaceLayers $nSurfaceLayers;
        }
        $buildingLayers;
    }

    relativeSizes       true;
    expansionRatio      1.3;
    finalLayerThickness 0.5;
    minThickness        1e-3;
}

writeFlags
(
    scalarLevels
    layerSets
    layerFields
);

// ************************************************************************* //
