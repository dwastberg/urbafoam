FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "caseParameters"

application     simpleFoam;

libs            (atmosphericModels);

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         $endTime;

deltaT          $deltaT;

writeControl    runTime;

writeInterval   $writeInterval;

purgeWrite      $purgeWrite;

writeFormat     binary;     // ascii can write subnormal numbers (e.g. 1e-314) that OpenFOAM cannot read back

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

// adjustTimeStep  yes;

// maxCo           1;

functions
{
}

