FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "caseParameters"

scale   1.0;

vertices
(
    ($xMin $yMin $zMin)  // 0
    ($xMax $yMin $zMin)  // 1
    ($xMax $yMax $zMin)  // 2
    ($xMin $yMax $zMin)  // 3
    ($xMin $yMin $zMax)  // 4
    ($xMax $yMin $zMax)  // 5
    ($xMax $yMax $zMax)  // 6
    ($xMin $yMax $zMax)  // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) background ($xCells $yCells $zCells) simpleGrading (1 1 $zGrading)
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)  // x min
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (1 2 6 5)  // x max
        );
    }
    ground
    {
        type wall;
        faces
        (
            (0 3 2 1)  // z min
        );
    }
    frontAndBack
    {
        type symmetry;
        faces
        (
            (0 1 5 4)  // y min
            (2 3 7 6)  // y max
            (4 5 6 7)  // z max
        );
    }
);

mergePatchPairs
(
);

