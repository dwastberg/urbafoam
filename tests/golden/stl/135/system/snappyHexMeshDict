FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// https://www.openfoam.com/documentation/cpp-guide/html/guide-meshing-snappyhexmesh-castellation.html

#include "etc/snappyHexMeshDict.cfg"

castellatedMesh on;
snap            on;
addLayers       off;

geometry
{

    buildings_small
    {
        type triSurfaceMesh;
        file "buildings_small.stl";
    }



    BoxZ  // refinement based on z level over whole domain
    {
     type searchableBox;
     min  (-42.917934995759055 -3.629140615536542 0.0);
     max  (573.9535404383013 279.21357185908255 0.0);
    }


    Box1 // central area
    {
        type searchableBox;
        min  (134.08206500424095 98.75058506143037 0.0);
        max  (204.95354043830125 176.83384618211562 48.0);
    }

    Plane1 // central area
    {
        type searchableBox;
        min  (134.08206500424095 98.75058506143037 0.0);
        max  (204.95354043830125 176.83384618211562 0.0);
    }


};

castellatedMeshControls
{


    features
    (
      {
        file  "buildings_small.eMesh";
        level 4;
      }
    );

    refinementSurfaces
    {

        buildings_small
        {
            level (2 4);
            patchInfo  { type wall; }
        }

    }

    refinementRegions
    {

     BoxZ  // Vertical throughout domain
     {
         mode distance;
         levels ((16.0 2));
     }

     Box1
     {
         mode inside;
         levels ((1e15 2));
     }

     Plane1
     {
         mode distance;
         levels ((3 4) (12 2));
     }

    }

    locationInMesh (-41.917934995759055 -2.629140615536542 143.0);
}

snapControls
{



    explicitFeatureSnap    true;
    implicitFeatureSnap    false;
}

addLayersControls
{
    layers
    {
        ".*"
        {
            nSurfaceLayers 2;
        }
    }

    relativeSizes       true;
    expansionRatio      1.3;
    finalLayerThickness 0.5;
    minThickness        1e-3;


}

writeFlags
(
    scalarLevels
    layerSets
    layerFields
);


